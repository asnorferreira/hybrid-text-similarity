{
  "name": "hts-web",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "seed": "tsx scripts/seed.ts",
    "integration": "tsx scripts/integration.ts",
    "test:e2e": "playwright test e2e/system.spec.ts",
    "test:equivalence": "playwright test e2e/equivalence.spec.ts",
    "test:unavailable": "playwright test e2e/unavailable.spec.ts",
    "test:security": "tsx scripts/security.ts",
    "load": "tsx scripts/load.ts"
  },
  "dependencies": {
    "mongodb": "7.7.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
