# Copie para .env e troque a senha. O .env não vai para o Git.
MONGO_ROOT_USER=hts
MONGO_ROOT_PASSWORD=troque-esta-senha
MONGO_PORT=27017

# Origem local fixa no Compose; o core e Mongo não publicam portas por padrão.
# Seeds exigem conta existente e variáveis de ambiente fornecidas ao comando, sem exibir valores.
# HTS_SEED_EMAIL=
# HTS_SEED_PASSWORD=
